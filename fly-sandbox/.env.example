# Fly.io API token (required)
FLY_API_TOKEN=your_fly_api_token_here

# Fly.io organization slug (optional, default: jido_dev)
# FLY_ORG=jido_dev

# Fly.io region (optional, default: ord)
# FLY_REGION=ord

# Default git repository for sandboxes (optional)
# SANDBOX_DEFAULT_REPO=git@github.com:agentjido/jido_workspace.git

# Git user info for commits in sandbox
# GIT_USER_NAME=Your Name
# GIT_USER_EMAIL=you@example.com

# API keys for coding agents (injected into sandbox)
# AMP_API_KEY=your_amp_api_key
# ANTHROPIC_API_KEY=your_anthropic_api_key
