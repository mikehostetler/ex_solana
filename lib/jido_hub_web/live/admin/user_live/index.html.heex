<div class="p-6">
  <.header>
    Users
    <:actions>
      <.button navigate={~p"/admin/users/new"}>
        <.icon name="hero-plus" class="w-4 h-4 mr-1" /> New User
      </.button>
    </:actions>
  </.header>

  <div class="mt-6">
    <.card>
      <div class="mb-4">
        <h3 class="text-sm font-semibold mb-3">Filters</h3>
        <.form for={@base_filters_form} phx-change="toggle_base_filters" id="base-filters-form">
          <div class="flex gap-6">
            <.input
              field={@base_filters_form[:show_is_suspended]}
              type="checkbox"
              label="Show suspended users"
            />
            <.input
              field={@base_filters_form[:show_is_deleted]}
              type="checkbox"
              label="Show deleted users"
            />
            <.input field={@base_filters_form[:online]} type="checkbox" label="Online only" />
          </div>
        </.form>
      </div>

      <.table id="users-table" rows={@users} row_id={fn user -> "user-#{user.id}" end}>
        <:col :let={user} label="ID">
          <span class="font-mono text-xs" title={user.id}>
            {String.slice(user.id, 0, 3)}...{String.slice(user.id, -3, 3)}
          </span>
        </:col>
        <:col :let={user} label="Username">
          {user.username}
        </:col>
        <:col :let={user} label="Email">
          {user.email}
        </:col>
        <:col :let={user} label="Status">
          <div class="flex gap-2">
            <.badge :if={user.is_suspended} variant="error">Suspended</.badge>
            <.badge :if={user.is_deleted} variant="warning">Deleted</.badge>
            <.badge :if={user.is_online} variant="success">Online</.badge>
          </div>
        </:col>
        <:col :let={user} label="Inserted At">
          {Calendar.strftime(user.inserted_at, "%Y-%m-%d %H:%M")}
        </:col>
        <:action :let={user}>
          <.user_actions user={user} current_user={@current_user} />
        </:action>
      </.table>

      <div class="mt-4 flex items-center justify-between">
        <div class="text-sm text-base-content/70">
          Showing {length(@users)} of {@meta.count} users
        </div>
        <div class="flex gap-2">
          <.button
            :if={@meta.page > 1}
            variant="secondary"
            size="sm"
            phx-click="update_filters"
            phx-value-filters={Jason.encode!(%{"page" => @meta.page - 1})}
          >
            <.icon name="hero-chevron-left" class="w-4 h-4" /> Previous
          </.button>
          <.button
            :if={@meta.page < @meta.total_pages}
            variant="secondary"
            size="sm"
            phx-click="update_filters"
            phx-value-filters={Jason.encode!(%{"page" => @meta.page + 1})}
          >
            Next <.icon name="hero-chevron-right" class="w-4 h-4" />
          </.button>
        </div>
      </div>
    </.card>
  </div>
</div>

<.modal
  :if={@live_action in [:new, :edit]}
  id="user-modal"
  show
  on_cancel={JS.patch(~p"/admin/users")}
>
  <div class="space-y-4">
    <h2 class="text-lg font-semibold">
      {if @live_action == :new, do: "New User", else: "Edit User"}
    </h2>
    <.live_component
      module={JidoHubWeb.Admin.UserLive.FormComponent}
      id={@user.id || :new}
      form={@form}
      user={@user}
      action={@live_action}
      patch={~p"/admin/users"}
    />
  </div>
</.modal>
