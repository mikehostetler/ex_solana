<.live_component
  module={JidoHubWeb.UI.CommandPalette}
  id="cmd-palette"
  open={@show_search_modal}
  commands={@commands}
  query={@search_query}
  keyboard_sequence=""
  keyboard_shortcuts={%{}}
/>

<JidoHubWeb.DashboardLayout.dashboard
  data_layout_key="jidohub:workflows:v1"
  default_right_open={true}
  default_bottom_open={true}
>
  <:header>
    <JidoHubWeb.Dashboard.TopNav.top_nav title="Workflows" />
  </:header>

  <:left>
    <.live_component module={JidoHubWeb.WorkspaceNav} id="workspace-nav" />
  </:left>

  <:main>
    <div class="h-full overflow-auto">
      <div class="p-4">
        <div class="mb-6">
          <h2 class="text-page-title mb-1">Main Content Area</h2>
          <p class="text-body opacity-70">This is where the main workflow content will appear.</p>
        </div>

        <.card class="overflow-hidden mt-6">
          <div class="border-b border-base-content/10 px-4 py-3 -m-4 mb-4 bg-base-100">
            <h3 class="text-subsection-header">Workflow List</h3>
          </div>
          <.table
            id="workflows-table"
            rows={[
              %{id: 1, name: "Sample Workflow 1", status: "active", last_run: "2 hours ago"},
              %{id: 2, name: "Sample Workflow 2", status: "paused", last_run: "1 day ago"}
            ]}
            row_id={fn row -> "workflow-#{row.id}" end}
          >
            <:col :let={workflow} label="Name">
              {workflow.name}
            </:col>
            <:col :let={workflow} label="Status">
              <%= if workflow.status == "active" do %>
                <.badge variant="success">Active</.badge>
              <% else %>
                <.badge variant="warning">Paused</.badge>
              <% end %>
            </:col>
            <:col :let={workflow} label="Last Run">
              {workflow.last_run}
            </:col>
          </.table>
        </.card>
      </div>
    </div>
  </:main>

  <:right>
    <div class="flex flex-col h-full">
      <div class="px-4 py-3 flex items-center justify-between">
        <h3 class="text-subsection-header">Details Panel</h3>
        <button class="btn btn-ghost btn-xs btn-square" x-on:click="rightOpen = false">
          <.icon name="hero-x-mark" class="w-4 h-4" />
        </button>
      </div>

      <div class="flex-1 overflow-y-auto p-4">
        <div class="border border-base-content/10 rounded-lg p-3 mb-3">
          <div class="text-meta opacity-60 mb-1">Created</div>
          <div class="text-body-medium">2 weeks ago</div>
        </div>

        <div class="border border-base-content/10 rounded-lg p-3 mb-3">
          <div class="text-meta opacity-60 mb-1">Owner</div>
          <div class="text-body-medium">You</div>
        </div>

        <div class="border border-base-content/10 rounded-lg p-3">
          <div class="text-meta opacity-60 mb-1">Status</div>
          <div class="text-body-medium">Active</div>
        </div>
      </div>
    </div>
  </:right>

  <:bottom>
    <BottomConsole.bottom_console>
      <div class="console-header">
        <div role="tablist" class="tabs tabs-bordered">
          <button role="tab" class="tab tab-active" data-tab="console">
            <.icon name="hero-command-line" class="w-3.5 h-3.5" /> Console
          </button>
          <button role="tab" class="tab" data-tab="logs">
            <.icon name="hero-document-text" class="w-3.5 h-3.5" /> Logs
          </button>
          <button role="tab" class="tab" data-tab="network">
            <.icon name="hero-signal" class="w-3.5 h-3.5" /> Network
          </button>
        </div>

        <div class="console-toolbar">
          <button
            class="btn btn-ghost btn-xs btn-square"
            data-action="clear"
            title="Clear console"
          >
            <.icon name="hero-x-circle" class="w-4 h-4" />
          </button>
          <div class="console-divider"></div>
          <button class="btn btn-ghost btn-xs btn-square" title="Filter">
            <.icon name="hero-funnel" class="w-4 h-4" />
          </button>
          <button class="btn btn-ghost btn-xs btn-square" title="Settings">
            <.icon name="hero-cog-6-tooth" class="w-4 h-4" />
          </button>
          <div class="console-divider"></div>
          <button
            class="btn btn-ghost btn-xs btn-square"
            x-on:click="toggleBottom()"
            title="Close console"
          >
            <.icon name="hero-chevron-down" class="w-4 h-4" />
          </button>
        </div>
      </div>

      <div class="console-content-section" data-section="console">
        <div class="console-output" data-output="console">
          <div class="console-log-entry console-info">
            <span class="console-icon">
              <.icon name="hero-information-circle" class="w-4 h-4" />
            </span>
            <span class="console-message">CONNECTED TO Phoenix.LiveView.Socket in 16μs</span>
          </div>

          <div class="console-log-entry console-info">
            <span class="console-icon">
              <.icon name="hero-check-circle" class="w-4 h-4" />
            </span>
            <span class="console-message">
              [CommandPalette] Hook mounted on element: command-palette-root
            </span>
          </div>

          <div class="console-log-entry console-info">
            <span class="console-icon">
              <.icon name="hero-check-circle" class="w-4 h-4" />
            </span>
            <span class="console-message">
              [CommandPalette] Keydown listener attached to window
            </span>
          </div>

          <div class="console-log-entry console-success">
            <span class="console-icon">
              <.icon name="hero-arrow-path" class="w-4 h-4" />
            </span>
            <span class="console-message">
              [info] GET /.well-known/appspecific/com.chrome.devtools.json
            </span>
          </div>
        </div>

        <div class="console-prompt">
          <span class="console-prompt-icon">></span>
          <input
            type="text"
            class="console-input"
            placeholder="Type JavaScript expression..."
            spellcheck="false"
            data-input="console"
          />
        </div>
      </div>

      <div class="console-content-section" data-section="logs" style="display: none;">
        <div class="console-output" data-output="logs">
          <div class="console-log-entry console-info">
            <span class="console-timestamp">12:34:56.789</span>
            <span class="console-icon">
              <.icon name="hero-information-circle" class="w-4 h-4" />
            </span>
            <span class="console-message">[info] Application started</span>
          </div>

          <div class="console-log-entry console-success">
            <span class="console-timestamp">12:35:01.234</span>
            <span class="console-icon">
              <.icon name="hero-check-circle" class="w-4 h-4" />
            </span>
            <span class="console-message">[info] Database connection established</span>
          </div>

          <div class="console-log-entry console-warning">
            <span class="console-timestamp">12:35:15.567</span>
            <span class="console-icon">
              <.icon name="hero-exclamation-triangle" class="w-4 h-4" />
            </span>
            <span class="console-message">[warn] Slow query detected (342ms)</span>
          </div>
        </div>
      </div>

      <div class="console-content-section" data-section="network" style="display: none;">
        <div class="console-output" data-output="network">
          <div class="console-network-header">
            <div class="console-network-col" style="flex: 0 0 80px;">Status</div>
            <div class="console-network-col" style="flex: 0 0 80px;">Method</div>
            <div class="console-network-col" style="flex: 1;">URL</div>
            <div class="console-network-col" style="flex: 0 0 80px;">Time</div>
            <div class="console-network-col" style="flex: 0 0 80px;">Size</div>
          </div>

          <div class="console-network-entry">
            <div class="console-network-col console-status-success" style="flex: 0 0 80px;">
              200 OK
            </div>
            <div class="console-network-col" style="flex: 0 0 80px;">GET</div>
            <div class="console-network-col" style="flex: 1;" title="/live/websocket">
              /live/websocket
            </div>
            <div class="console-network-col" style="flex: 0 0 80px;">16ms</div>
            <div class="console-network-col" style="flex: 0 0 80px;">1.2 KB</div>
          </div>

          <div class="console-network-entry">
            <div class="console-network-col console-status-cached" style="flex: 0 0 80px;">
              304
            </div>
            <div class="console-network-col" style="flex: 0 0 80px;">GET</div>
            <div class="console-network-col" style="flex: 1;" title="/assets/app.css">
              /assets/app.css
            </div>
            <div class="console-network-col" style="flex: 0 0 80px;">8ms</div>
            <div class="console-network-col" style="flex: 0 0 80px;">cached</div>
          </div>

          <div class="console-network-entry">
            <div class="console-network-col console-status-success" style="flex: 0 0 80px;">
              200 OK
            </div>
            <div class="console-network-col" style="flex: 0 0 80px;">POST</div>
            <div class="console-network-col" style="flex: 1;" title="/api/workflows">
              /api/workflows
            </div>
            <div class="console-network-col" style="flex: 0 0 80px;">234ms</div>
            <div class="console-network-col" style="flex: 0 0 80px;">3.4 KB</div>
          </div>
        </div>
      </div>
    </BottomConsole.bottom_console>
  </:bottom>
</JidoHubWeb.DashboardLayout.dashboard>
