  <%!-- Problem Section --%>
  <section id="problem" class="py-24 px-4">
    <div class="container mx-auto max-w-7xl">
      <div class="flex items-center gap-2 mb-6">
        <div class="w-8 h-[1px] bg-warning"></div>
        <div class="text-sm tracking-wider uppercase text-warning font-semibold">
          The Challenge
        </div>
      </div>

      <div class="grid lg:grid-cols-2 gap-12 items-center">
        <div>
          <h2 class="text-4xl md:text-5xl font-bold mb-6 leading-tight">
            AI agents are everywhere, but <span class="text-warning">ROI remains elusive</span>
          </h2>
          <p class="text-lg opacity-80 mb-6">
            Organizations deploy AI across multiple platforms, creating fragmented ecosystems with minimal returns.
          </p>
        </div>

        <div class="space-y-4">
          <div class="flex items-start gap-4 p-4 rounded-lg bg-base-200/50 border border-base-300/40">
            <.icon name="hero-chat-bubble-left-right" class="w-6 h-6 text-primary mt-1 shrink-0" />
            <div>
              <div class="font-semibold mb-1">Slack bot for notifications</div>
              <div class="text-sm opacity-60">Operating in isolation</div>
            </div>
          </div>

          <div class="flex items-start gap-4 p-4 rounded-lg bg-base-200/50 border border-base-300/40">
            <.icon name="hero-calendar" class="w-6 h-6 text-primary mt-1 shrink-0" />
            <div>
              <div class="font-semibold mb-1">Calendar assistant for scheduling</div>
              <div class="text-sm opacity-60">No shared context</div>
            </div>
          </div>

          <div class="flex items-start gap-4 p-4 rounded-lg bg-base-200/50 border border-base-300/40">
            <.icon name="hero-document-text" class="w-6 h-6 text-primary mt-1 shrink-0" />
            <div>
              <div class="font-semibold mb-1">Content generator for marketing</div>
              <div class="text-sm opacity-60">Disconnected workflows</div>
            </div>
          </div>

          <div class="flex items-start gap-4 p-4 rounded-lg bg-base-200/50 border border-base-300/40">
            <.icon name="hero-chart-bar" class="w-6 h-6 text-primary mt-1 shrink-0" />
            <div>
              <div class="font-semibold mb-1">Analytics agent in dashboard</div>
              <div class="text-sm opacity-60">Fragmented intelligence</div>
            </div>
          </div>
        </div>
      </div>

      <div class="mt-12 p-8 rounded-2xl bg-gradient-to-br from-warning/10 to-warning/5 border border-warning/20">
        <p class="text-xl font-semibold text-center">
          Intelligence without orchestration is just expensive noise.
        </p>
      </div>
    </div>
  </section>

  <%!-- Solution Section --%>
  <section id="solution" class="py-24 px-4 bg-base-200">
    <div class="container mx-auto max-w-7xl">
      <div class="flex items-center gap-2 mb-6">
        <div class="w-8 h-[1px] bg-primary"></div>
        <div class="text-sm tracking-wider uppercase text-primary font-semibold">
          Our Solution
        </div>
      </div>

      <h2 class="text-4xl md:text-5xl font-bold mb-6 max-w-3xl leading-tight">
        Pod Workspaces for
        <span class="bg-gradient-to-r from-primary to-secondary bg-clip-text text-transparent">
          Intelligent Coordination
        </span>
      </h2>

      <p class="text-xl opacity-80 mb-12 max-w-3xl">
        Organize agents into coordinated teams within dedicated workspaces. Keep contexts separate, switch instantly, maintain complete control.
      </p>

      <div class="grid lg:grid-cols-3 gap-6 mb-12">
        <div class="p-6 rounded-xl bg-base-100 border border-base-300/40 hover:border-primary/40 transition-colors">
          <.icon name="hero-briefcase" class="w-8 h-8 text-primary mb-4" />
          <h3 class="text-lg font-bold mb-2">@work</h3>
          <p class="text-sm opacity-70">
            Sales, marketing, and operations agents collaborate with shared context
          </p>
        </div>

        <div class="p-6 rounded-xl bg-base-100 border border-base-300/40 hover:border-secondary/40 transition-colors">
          <.icon name="hero-home" class="w-8 h-8 text-secondary mb-4" />
          <h3 class="text-lg font-bold mb-2">@personal</h3>
          <p class="text-sm opacity-70">
            Family, finance, and health agents stay completely isolated
          </p>
        </div>

        <div class="p-6 rounded-xl bg-base-100 border border-base-300/40 hover:border-accent/40 transition-colors">
          <.icon name="hero-light-bulb" class="w-8 h-8 text-accent mb-4" />
          <h3 class="text-lg font-bold mb-2">@side-project</h3>
          <p class="text-sm opacity-70">
            Business agents operate with separate credentials entirely
          </p>
        </div>
      </div>

      <.card class="max-w-2xl mx-auto">
        <div class="flex items-center justify-between mb-6">
          <div>
            <h3 class="text-xl font-semibold">Pod Example: @sarah/work</h3>
            <p class="text-sm opacity-60 mt-1">Work Automation Hub • 4 agents active</p>
          </div>
          <.badge variant="success">Live</.badge>
        </div>

        <div class="space-y-3 mb-6">
          <div class="flex items-center justify-between p-3 rounded-lg bg-base-200/50">
            <div class="flex items-center gap-3">
              <div class="w-2 h-2 rounded-full bg-success animate-pulse"></div>
              <span class="font-medium">Sales Report Bot</span>
            </div>
            <.badge variant="success" size="sm">Running</.badge>
          </div>

          <div class="flex items-center justify-between p-3 rounded-lg bg-base-200/50">
            <div class="flex items-center gap-3">
              <div class="w-2 h-2 rounded-full bg-info"></div>
              <span class="font-medium">Slack Monitor</span>
            </div>
            <.badge variant="info" size="sm">Idle</.badge>
          </div>

          <div class="flex items-center justify-between p-3 rounded-lg bg-base-200/50">
            <div class="flex items-center gap-3">
              <div class="w-2 h-2 rounded-full bg-warning animate-pulse"></div>
              <span class="font-medium">Meeting Scheduler</span>
            </div>
            <.badge variant="warning" size="sm">Processing</.badge>
          </div>

          <div class="flex items-center justify-between p-3 rounded-lg bg-base-200/50">
            <div class="flex items-center gap-3">
              <div class="w-2 h-2 rounded-full bg-success animate-pulse"></div>
              <span class="font-medium">Lead Scorer</span>
            </div>
            <.badge variant="success" size="sm">Running</.badge>
          </div>
        </div>

        <div class="border-t border-base-300/40 pt-6">
          <p class="text-sm font-semibold mb-3 flex items-center gap-2">
            <.icon name="hero-bolt" class="w-4 h-4 text-primary" /> Recent Coordination
          </p>
          <div class="space-y-2 text-sm opacity-80 ml-6">
            <div class="flex items-start gap-2">
              <span class="text-success mt-0.5">✓</span>
              <span>Lead Scorer found 3 qualified prospects</span>
            </div>
            <div class="flex items-start gap-2">
              <span class="text-primary mt-0.5">→</span>
              <span>Email Bot sent personalized outreach (using lead context)</span>
            </div>
            <div class="flex items-start gap-2">
              <span class="text-primary mt-0.5">→</span>
              <span>CRM Bot scheduled follow-up tasks</span>
            </div>
            <div class="flex items-start gap-2">
              <span class="text-primary mt-0.5">→</span>
              <span>Calendar Bot blocked time for calls</span>
            </div>
          </div>
        </div>
      </.card>
    </div>
  </section>

  <%!-- Capabilities Section --%>
  <section id="capabilities" class="py-24 px-4">
    <div class="container mx-auto max-w-7xl">
      <div class="text-center mb-16">
        <div class="flex items-center justify-center gap-2 mb-6">
          <div class="w-8 h-[1px] bg-current opacity-40"></div>
          <div class="text-sm tracking-wider uppercase opacity-60">Core Capabilities</div>
          <div class="w-8 h-[1px] bg-current opacity-40"></div>
        </div>

        <h2 class="text-4xl md:text-5xl font-bold mb-4">
          Three Pillars of
          <span class="bg-gradient-to-r from-primary to-secondary bg-clip-text text-transparent">
            Orchestration Excellence
          </span>
        </h2>
      </div>

      <div class="grid md:grid-cols-3 gap-8">
        <.card class="text-center group hover:border-primary/40 transition-all duration-300">
          <div class="inline-flex items-center justify-center w-16 h-16 rounded-2xl bg-primary/10 mb-6 group-hover:scale-110 transition-transform">
            <.icon name="hero-chart-bar" class="w-8 h-8 text-primary" />
          </div>
          <h3 class="text-2xl font-bold mb-4">Resource Allocation</h3>
          <p class="opacity-70 leading-relaxed">
            Treat compute and credentials like capital. Each pod has isolated API access and usage limits. Work agents can't burn personal API quotas.
          </p>
        </.card>

        <.card class="text-center group hover:border-secondary/40 transition-all duration-300">
          <div class="inline-flex items-center justify-center w-16 h-16 rounded-2xl bg-secondary/10 mb-6 group-hover:scale-110 transition-transform">
            <.icon name="hero-users" class="w-8 h-8 text-secondary" />
          </div>
          <h3 class="text-2xl font-bold mb-4">Agent Collaboration</h3>
          <p class="opacity-70 leading-relaxed">
            Agents within pods share context and hand off tasks seamlessly. Marketing finds a lead → Sales sends outreach → CRM logs interaction.
          </p>
        </.card>

        <.card class="text-center group hover:border-accent/40 transition-all duration-300">
          <div class="inline-flex items-center justify-center w-16 h-16 rounded-2xl bg-accent/10 mb-6 group-hover:scale-110 transition-transform">
            <.icon name="hero-eye" class="w-8 h-8 text-accent" />
          </div>
          <h3 class="text-2xl font-bold mb-4">Real-time Visibility</h3>
          <p class="opacity-70 leading-relaxed">
            See every agent action, handoff, and decision. Complete transparency into your AI coordination fabric.
          </p>
        </.card>
      </div>
    </div>
  </section>

  <%!-- Competitive Reality Section --%>
  <section id="competitive-reality" class="py-24 px-4 bg-base-200">
    <div class="container mx-auto max-w-7xl">
      <div class="text-center mb-16">
        <div class="flex items-center justify-center gap-2 mb-6">
          <div class="w-8 h-[1px] bg-current opacity-40"></div>
          <div class="text-sm tracking-wider uppercase opacity-60">Results That Matter</div>
          <div class="w-8 h-[1px] bg-current opacity-40"></div>
        </div>

        <h2 class="text-4xl md:text-5xl font-bold mb-4">
          The
          <span class="bg-gradient-to-r from-primary to-secondary bg-clip-text text-transparent">
            Coordination Advantage
          </span>
        </h2>
        <p class="text-xl opacity-70 max-w-3xl mx-auto">
          Organizations with systematic orchestration achieve measurably higher ROI
        </p>
      </div>

      <div class="grid md:grid-cols-2 gap-8 max-w-5xl mx-auto">
        <.card class="border-2 border-error/20 hover:border-error/40 transition-colors">
          <div class="flex items-center gap-3 mb-6">
            <div class="w-12 h-12 rounded-xl bg-error/10 flex items-center justify-center">
              <.icon name="hero-x-mark" class="w-6 h-6 text-error" />
            </div>
            <h3 class="text-2xl font-bold">Without Coordination</h3>
          </div>

          <ul class="space-y-3">
            <li class="flex items-start gap-3 text-sm opacity-80">
              <span class="text-error mt-0.5">•</span>
              <span>Contradictory agent actions waste resources</span>
            </li>
            <li class="flex items-start gap-3 text-sm opacity-80">
              <span class="text-error mt-0.5">•</span>
              <span>No shared context across teams</span>
            </li>
            <li class="flex items-start gap-3 text-sm opacity-80">
              <span class="text-error mt-0.5">•</span>
              <span>Duplicate efforts, missed opportunities</span>
            </li>
          </ul>
        </.card>

        <.card class="border-2 border-success/20 hover:border-success/40 transition-colors">
          <div class="flex items-center gap-3 mb-6">
            <div class="w-12 h-12 rounded-xl bg-success/10 flex items-center justify-center">
              <.icon name="hero-check-circle" class="w-6 h-6 text-success" />
            </div>
            <h3 class="text-2xl font-bold">With JidoHub</h3>
          </div>

          <ul class="space-y-3">
            <li class="flex items-start gap-3 text-sm opacity-80">
              <span class="text-success mt-0.5">✓</span>
              <span>Coordinated intelligence across all agents</span>
            </li>
            <li class="flex items-start gap-3 text-sm opacity-80">
              <span class="text-success mt-0.5">✓</span>
              <span>Seamless handoffs with full context</span>
            </li>
            <li class="flex items-start gap-3 text-sm opacity-80">
              <span class="text-success mt-0.5">✓</span>
              <span>Measurable ROI and efficiency gains</span>
            </li>
          </ul>
        </.card>
