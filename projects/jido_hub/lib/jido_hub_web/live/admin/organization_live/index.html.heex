<div class="p-6">
  <.header>
    Organizations
  </.header>

  <div class="mt-6">
    <.card>
      <.table
        id="organizations-table"
        rows={@organizations}
        row_id={fn organization -> "organization-#{organization.id}" end}
      >
        <:col :let={organization} label="ID">
          <span class="font-mono text-xs" title={organization.id}>
            {String.slice(organization.id, 0, 3)}...{String.slice(organization.id, -3, 3)}
          </span>
        </:col>
        <:col :let={organization} label="Name">
          {organization.name}
        </:col>
        <:col :let={organization} label="Slug">
          <span class="font-mono text-sm">{organization.slug}</span>
        </:col>
        <:col :let={organization} label="Owner">
          {organization.owner.email}
        </:col>
        <:col :let={organization} label="Created">
          {Calendar.strftime(organization.inserted_at, "%Y-%m-%d %H:%M")}
        </:col>
        <:action :let={organization}>
          <.organization_actions organization={organization} />
        </:action>
      </.table>

      <div class="mt-4 flex items-center justify-between">
        <div class="text-sm text-base-content/70">
          Showing {length(@organizations)} of {@meta.count} organizations
        </div>
        <div class="flex gap-2">
          <.button
            :if={@meta.page > 1}
            variant="secondary"
            size="sm"
            phx-click="update_filters"
            phx-value-filters={Jason.encode!(%{"page" => @meta.page - 1})}
          >
            <.icon name="hero-chevron-left" class="w-4 h-4" /> Previous
          </.button>
          <.button
            :if={@meta.page < @meta.total_pages}
            variant="secondary"
            size="sm"
            phx-click="update_filters"
            phx-value-filters={Jason.encode!(%{"page" => @meta.page + 1})}
          >
            Next <.icon name="hero-chevron-right" class="w-4 h-4" />
          </.button>
        </div>
      </div>
    </.card>
  </div>
</div>

<.modal
  :if={@live_action == :edit}
  id="organization-modal"
  show
  on_cancel={JS.patch(~p"/admin/organizations")}
>
  <div class="space-y-4">
    <h2 class="text-lg font-semibold">Edit Organization</h2>
    <.live_component
      module={JidoHubWeb.Admin.OrganizationLive.FormComponent}
      id={@organization.id}
      form={@form}
      organization={@organization}
      action={@live_action}
      patch={~p"/admin/organizations"}
    />
  </div>
</.modal>
