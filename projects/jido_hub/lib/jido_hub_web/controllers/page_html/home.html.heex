<div class="min-h-screen bg-base-100">
  <%!-- Hero Section --%>
  <section id="hero" class="relative py-20 px-4 overflow-hidden">
    <div class="container mx-auto max-w-7xl">
      <div class="grid lg:grid-cols-2 gap-12 items-center">
        <div>
          <div class="inline-flex items-center gap-2 mb-6 text-sm tracking-wider uppercase opacity-70">
            <div class="w-8 h-[1px] bg-current"></div>
            <span>Award-Winning AI Orchestration Platform</span>
          </div>

          <h1 class="text-5xl md:text-7xl font-extrabold leading-tight mb-6">
            Elevate Your
            <span class="bg-gradient-to-r from-primary to-secondary bg-clip-text text-transparent">
              AI Coordination
            </span>
          </h1>

          <p class="text-lg md:text-xl opacity-80 mb-8 max-w-xl">
            Strategic orchestration solutions that drive measurable ROI and create lasting agent coordination through innovative technology.
          </p>

          <div class="flex flex-wrap gap-4 mb-12">
            <.button navigate="/signup" size="lg">
              Start Project <.icon name="hero-arrow-right" class="w-5 h-5 ml-2" />
            </.button>
            <.button variant="ghost" size="lg">View Case Studies</.button>
          </div>

          <div class="grid grid-cols-3 gap-8 pt-8 border-t border-base-300/40">
            <div>
              <div class="text-3xl font-bold text-primary mb-1">250+</div>
              <div class="text-sm opacity-60">Projects</div>
            </div>
            <div>
              <div class="text-3xl font-bold text-primary mb-1">98%</div>
              <div class="text-sm opacity-60">Success Rate</div>
            </div>
            <div>
              <div class="text-3xl font-bold text-primary mb-1">15+</div>
              <div class="text-sm opacity-60">Awards</div>
            </div>
          </div>
        </div>

        <div class="relative hidden lg:block">
          <div class="relative rounded-2xl overflow-hidden shadow-2xl">
            <div class="absolute top-6 right-6 bg-base-100/90 backdrop-blur-sm rounded-xl p-4 shadow-lg z-10">
              <div class="text-3xl font-bold text-primary mb-1">#1</div>
              <div class="text-xs opacity-70">Agency Ranking</div>
            </div>

            <div class="aspect-[4/5] bg-gradient-to-br from-primary/20 to-secondary/20 flex items-center justify-center">
              <div class="text-center p-8">
                <.icon name="hero-light-bulb" class="w-32 h-32 mx-auto mb-4 text-primary" />
                <div class="text-sm opacity-70">Trusted by</div>
                <div class="text-xl font-bold">500+ Companies</div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

