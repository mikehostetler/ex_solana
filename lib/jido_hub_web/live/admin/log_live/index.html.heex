<div class="p-6">
  <.header>
    Application Logs
    <:actions>
      <.form
        for={%{}}
        as={:live_toggle}
        phx-change="toggle_live_logs"
        id="live-logs-toggle"
        class="flex items-center gap-2"
      >
        <.input
          name="enable_live_logs"
          type="checkbox"
          label="Live updates"
          value={@enable_live_logs}
          checked={@enable_live_logs}
        />
      </.form>
    </:actions>
  </.header>

  <div class="mt-6">
    <.card>
      <div class="mb-4">
        <h3 class="text-sm font-semibold mb-3">Filters</h3>
        <.form for={%{}} as={:filters} phx-submit="search" id="log-filters-form">
          <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
            <.input
              name="filters[action]"
              type="text"
              label="Action"
              placeholder="e.g. user.login"
              value={@filters[:action]}
            />
            <.input
              name="filters[user_id]"
              type="text"
              label="User ID"
              placeholder="UUID"
              value={@filters[:user_id]}
            />
            <.input
              name="filters[org_id]"
              type="text"
              label="Organization ID"
              placeholder="UUID"
              value={@filters[:org_id]}
            />
          </div>
          <div class="mt-4 flex gap-2">
            <.button type="submit" size="sm">
              <.icon name="hero-magnifying-glass" class="w-4 h-4 mr-1" /> Search
            </.button>
            <.button type="button" variant="secondary" size="sm" phx-click="reset_filters">
              <.icon name="hero-x-mark" class="w-4 h-4 mr-1" /> Reset
            </.button>
          </div>
        </.form>
      </div>

      <.table id="logs-table" rows={@logs} row_id={fn log -> "log-#{log.id}" end}>
        <:col :let={log} label="Time">
          <span class="text-sm whitespace-nowrap" title={log.inserted_at}>
            {relative_time(log.inserted_at)}
          </span>
        </:col>
        <:col :let={log} label="User">
          <%= if log.user_id && Ash.Resource.loaded?(log, :user) && log.user do %>
            <.link
              patch={~p"/admin/logs?user_id=#{log.user_id}"}
              class="text-sm hover:underline"
            >
              {log.user.username}
            </.link>
          <% else %>
            <span class="text-sm text-base-content/50">
              {log.user_type}
            </span>
          <% end %>
        </:col>
        <:col :let={log} label="Organization">
          <%= if log.org_id && Ash.Resource.loaded?(log, :organization) && log.organization do %>
            <.link
              patch={~p"/admin/logs?org_id=#{log.org_id}"}
              class="text-sm hover:underline"
            >
              {log.organization.name}
            </.link>
          <% else %>
            <span class="text-sm text-base-content/50">-</span>
          <% end %>
        </:col>
        <:col :let={log} label="Action">
          <.link
            patch={~p"/admin/logs?action=#{log.action}"}
            class="text-sm font-mono hover:underline"
          >
            {log.action}
          </.link>
        </:col>
        <:col :let={log} label="Target User">
          <%= if log.target_user_id && Ash.Resource.loaded?(log, :target_user) && log.target_user do %>
            <.link
              patch={~p"/admin/logs?user_id=#{log.target_user_id}"}
              class="text-sm hover:underline"
            >
              {log.target_user.username}
            </.link>
          <% else %>
            <span class="text-sm text-base-content/50">-</span>
          <% end %>
        </:col>
        <:col :let={log} label="Metadata">
          <span class="text-xs font-mono text-base-content/70" title={inspect(log.metadata)}>
            {format_metadata(log.metadata)}
          </span>
        </:col>
      </.table>

      <div :if={@has_more} class="mt-4 flex justify-center">
        <.button variant="secondary" size="sm" phx-click="load_more">
          Load more
        </.button>
      </div>

      <div :if={length(@logs) == 0} class="mt-4 text-center text-base-content/50">
        No logs found
      </div>
    </.card>
  </div>
</div>
